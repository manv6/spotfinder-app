{
  "expo": {
    "name": "SpotFinder",
    "slug": "spotfinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06080c",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SpotFinder uses your location to place you on the venue map and guide you back to your saved spot.",
        "NSMotionUsageDescription": "SpotFinder uses the compass/motion sensors to point the navigation arrow toward your saved spot."
      },
      "bundleIdentifier": "com.manv6.spotfinder"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06080c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SpotFinder uses your location to place you on the venue map and guide you back to your saved spot."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/spotfinder-app"
    }
  }
}
